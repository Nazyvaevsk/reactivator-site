{
  "name": "reactivator-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:new": "node scripts/content-new.cjs",
    "content:check": "node scripts/test-knowledge.cjs",
    "indexnow": "node scripts/indexnow-submit.cjs",
    "indexnow:file": "node scripts/indexnow-submit.cjs --file",
